# Copia este archivo como .env y pon los valores reales.
# El archivo .env nunca se sube al repositorio.
# Cada línea es NOMBRE=valor. Los comentarios van en su propia línea, nunca al lado de un valor.

# Django

# Qué ajustes usar. En tu computador no hace falta (usa los de desarrollo).
# En el servidor, quítale el # a la línea de abajo (docs/guia-publicacion.md, paso 10).
# DJANGO_SETTINGS_MODULE=config.settings.produccion

# Clave secreta, larga y al azar. En el servidor es obligatoria y de 50 caracteres o más.
# Se genera con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True solo en tu computador. En el servidor no se usa: siempre queda apagado.
DJANGO_DEBUG=True
# Los nombres con los que se entra, separados por comas. En el servidor: TU_DOMINIO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Solo en el servidor (en tu computador déjalas vacías) ---

# La dirección completa con https://, por ejemplo: https://TU_DOMINIO
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cuánto tiempo recuerda el navegador que debe entrar siempre por https, en segundos.
# Vacío es una hora (3600). Después de una semana sin problemas: 31536000 (un año).
DJANGO_HSTS_SEGUNDOS=
# True obliga también a todos los subdominios (www, correo, etc.) a ir por https.
# Vacío es False. Déjalo así salvo que todos tus subdominios tengan https.
DJANGO_HSTS_SUBDOMINIOS=
# Carpeta de las fotos y logos subidos. En el servidor es obligatoria: /srv/taller/media
# (la misma que usan NGINX y la copia de seguridad). En tu computador déjala vacía: se usa
# la carpeta media/ dentro del proyecto.
DJANGO_MEDIA_ROOT=
# Carpeta donde collectstatic deja los estilos, fuentes e íconos.
# Vacío es la carpeta staticfiles/ dentro del proyecto (está bien también en el servidor).
DJANGO_STATIC_ROOT=

# Base de datos PostgreSQL
DB_NAME=taller
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Asistente del taller (docs/10-asistente.md): la clave de la API de Claude, de la consola
# de Anthropic. Vacía, el asistente no aparece. Además, cada taller lo tiene apagado hasta
# que David le pone límites de preguntas en /admin. Las pruebas nunca la usan.
ANTHROPIC_API_KEY=
